    "audioRecordingConfig": {
    },
    "bigqueryExportSettings": {
    },
    "cloudLoggingSettings": {
    },
    "conversationLoggingSettings": {
      "retentionWindow": "31536000s"
    },
    "metricAnalysisSettings": {
    },
    "unredactedBigqueryExportSettings": {
    }
  },
  "guardrails": ["Default Safety Guardrail", "Default Prompt Guardrail"],
  "modelSettings": {
    "model": "gemini-composite-v2"
  },
  "variableDeclarations": [{
    "name": "caller_account_id",
    "schema": {
      "type": "STRING"
    }
  }, {
    "name": "caller_contact_id",
    "schema": {
      "type": "STRING"
    }
  }, {
    "name": "caller_email",
    "schema": {
      "type": "STRING"
    }
  }, {
    "name": "caller_name",
    "schema": {
      "type": "STRING"
    }
  }, {
    "name": "caller_status",
    "schema": {
      "type": "STRING"
    }
  }, {
    "name": "caller_verified",
    "schema": {
      "type": "BOOLEAN",
      "default": false
    }
  }, {
    "name": "company_name",
    "schema": {
      "type": "STRING",
      "default": "Abbott"
    }
  }, {
    "name": "last_order_id",
    "schema": {
      "type": "STRING"
    }
  }, {
    "name": "telephony-caller-id",
    "schema": {
      "type": "STRING",
      "default": "+14155550101"
    }
  }, {
    "name": "verification_attempts",
    "schema": {
      "type": "NUMBER",
      "default": 0.0
    }
